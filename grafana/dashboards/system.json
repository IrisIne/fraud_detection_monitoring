{
  "uid": "fraud-system",
  "title": "Система и срез транзакций",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "fraud",
    "monitoring"
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU Utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory Utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Network Traffic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(node_network_receive_bytes_total[1m]) + rate(node_network_transmit_bytes_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Disk I/O",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(node_disk_read_bytes_total[1m]) + rate(node_disk_written_bytes_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Плотность скоров по диапазонам",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH bucketed AS (SELECT LEAST(floor(score * 20), 19) / 20.0 AS bucket FROM transaction_scores WHERE us_state LIKE ${state:sqlstring} AND merch LIKE ${merchant:sqlstring} AND $__timeFilter(created_at)) SELECT to_char(bucket::numeric, 'FM0.00') || '-' || to_char((bucket + 0.05)::numeric, 'FM0.00') AS score_range, count(*)::double precision / (sum(count(*)) OVER () * 0.05) AS density FROM bucketed GROUP BY bucket ORDER BY bucket",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 6,
      "title": "TPS выбранных транзакций",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_bin('10 seconds', created_at, TIMESTAMPTZ '2000-01-01') AS time, count(*) / 10.0 AS tps FROM transaction_scores WHERE us_state LIKE ${state:sqlstring} AND merch LIKE ${merchant:sqlstring} AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Доля фрода по категориям, последние 1000",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH recent AS (SELECT cat_id, fraud_flag FROM transaction_scores ORDER BY created_at DESC LIMIT 1000) SELECT cat_id, round(100.0 * avg(fraud_flag), 2) AS fraud_share_pct FROM recent GROUP BY cat_id ORDER BY fraud_share_pct DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 8,
      "title": "Средний скор по категориям",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT cat_id, round(avg(score)::numeric, 3) AS average_score FROM transaction_scores WHERE us_state LIKE ${state:sqlstring} AND merch LIKE ${merchant:sqlstring} AND $__timeFilter(created_at) GROUP BY cat_id ORDER BY average_score DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "state",
        "label": "Штат",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT us_state FROM transaction_scores WHERE us_state <> '' ORDER BY us_state",
        "refresh": 1,
        "includeAll": true,
        "allValue": "'%'",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "merchant",
        "label": "Продавец",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT merch FROM transaction_scores WHERE merch <> '' ORDER BY merch",
        "refresh": 1,
        "includeAll": true,
        "allValue": "'%'",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
